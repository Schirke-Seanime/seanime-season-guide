{
  "id": "season-guide",
  "name": "Season Guide",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/Schirke/seanime-season-guide/main/src/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Every anime of a season, sorted by how well it matches your taste, with a top-10 tier list, your list status and AniLiberty dubs.",
  "author": "Schirke",
  "icon": "https://raw.githubusercontent.com/Schirke/seanime-season-guide/main/src/icon.png",
  "website": "https://github.com/Schirke/seanime-season-guide",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/Schirke/seanime-season-guide/main/src/SeasonGuide.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist",
        "anilist-token",
        "database",
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "aniliberty.top"
          ]
        }
      }
    }
  }
}
